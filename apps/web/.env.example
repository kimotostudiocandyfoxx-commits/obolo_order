# URL of the API on Cloud Run, e.g. https://obolo-api-xxxxx-an.a.run.app
# Leave EMPTY to run the web app in self-contained DEMO MODE (data stays in the browser).
NEXT_PUBLIC_API_URL=

# Earth mail in real time: the Firebase web app config (public), one line of JSON, e.g.
# {"apiKey":"…","authDomain":"…","projectId":"…","appId":"…"}
NEXT_PUBLIC_FIREBASE_CONFIG=
