{
  "name": "@obolo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=.env --watch dist/main.js)",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate-cli.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@obolo/ai": "workspace:*",
    "@obolo/ledger": "workspace:*",
    "@obolo/media": "workspace:*",
    "@obolo/shared": "workspace:*",
    "agora-token": "^2.0.6",
    "bullmq": "^5.60.0",
    "drizzle-orm": "^0.45.0",
    "express": "^5.1.0",
    "firebase-admin": "^13.10.0",
    "ioredis": "^5.8.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0"
  },
  "files": [
    "dist",
    "drizzle",
    "assets"
  ]
}
