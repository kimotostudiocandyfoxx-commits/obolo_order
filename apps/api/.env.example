# Copy to apps/api/.env for local dev. In Cloud Run, set these as env vars / Secret Manager.
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/obolo
# Cloud SQL from Cloud Run (unix socket):
# DATABASE_URL=postgres://obolo:PASSWORD@/obolo?host=/cloudsql/PROJECT_ID:asia-northeast1:obolo-pg
# DATABASE_READ_URL=            # read replica (optional)
DB_POOL_MAX=5
MIGRATE_ON_START=true

# Upstash Redis (TLS): rediss://default:TOKEN@HOST.upstash.io:6379
REDIS_URL=redis://localhost:6379
QUEUE_DRIVER=inline

# Exact origins and /regex/ entries, comma separated
CORS_ORIGINS=http://localhost:3000,/^https:\/\/obolo-order[a-z0-9-]*\.vercel\.app$/

# PLACEHOLDER: demo shows the login code in the UI until email is wired. false in production!
AUTH_DEMO_SHOW_CODE=true
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM=Obolo Order <no-reply@example.com>

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest  (default; follows Google's current Flash-Lite)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

BUDDY_FREE_DAILY=30
BUDDY_OVERAGE_ENABLED=false
DEMO_SIGNUP_GRANT_MANA=88

# Bunny Storage (PLACEHOLDER) — when empty, uploads are stored in Postgres (dev only)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_STORAGE_ENDPOINT=sg.storage.bunnycdn.com
BUNNY_CDN_HOST=
# PUBLIC_API_URL=   # optional; derived from the request host when empty
